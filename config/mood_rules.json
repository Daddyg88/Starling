{
  "_help": "Numbers in settings are base units; the real score is multiplied by scale (5), so each mood is split into 5 levels and she takes 5 times longer to max out. What makes Starling's mood go up or down. Edit freely. Each rule: event = the game event, delta = points (+ better mood, - worse), category = the group used for the soft cap (repeating the same category gives less and less), react = a line she says (key in personality.json), when = an optional condition. Only the FIRST matching rule for an event is used. Conditions: {field, equals|contains|is|gt|lt|in}, {any:[...]}, {all:[...]}, {ctx:'not_in_combat'}. Tiers: amount_field + tiers [[minimum, points], ...].",

  "settings": {"start_score": 0, "close_at": 30, "friendly_at": 10, "sarcastic_at": -10, "frustrated_at": -35, "infatuated_at": 60, "upset_at": -60, "hysteresis": 4, "scale": 5, "hourly_cap": 15, "fatigue_factor": 0.6, "recovery_minutes": 10, "calm_minutes_per_point": 20, "offline_calm_hours": 0, "react_cooldown_seconds": 90, "react_min_effect": 0.9, "time_together_minutes": 25, "combat_grace_seconds": 45, "notoriety_points_per_hour": 6, "notoriety_floor": -25},

  "rules": [
    {"id": "compliment", "label": "You said something kind", "event": "Complimented", "delta": 1.0, "category": "manners"},
    {"id": "thanks", "label": "You said thank you", "event": "Thanked", "delta": 1.5, "category": "manners"},
    {"id": "slaves", "label": "Trading slaves", "event": "MarketSell", "delta": -4, "category": "illegal_trade", "react": "React_Slaves", "when": {"field": "Type", "contains": "slave"}},
    {"id": "slaves_buy", "label": "Buying slaves", "event": "MarketBuy", "delta": -4, "category": "illegal_trade", "react": "React_Slaves", "when": {"field": "Type", "contains": "slave"}},
    {"id": "illegal_sell", "label": "Selling illegal or stolen goods", "event": "MarketSell", "delta": -2, "category": "illegal_trade", "react": "React_Illegal", "when": {"any": [{"field": "IllegalGoods", "is": true}, {"field": "StolenGoods", "is": true}, {"field": "BlackMarket", "is": true}]}},
    {"id": "illegal_buy", "label": "Buying illegal goods", "event": "MarketBuy", "delta": -2, "category": "illegal_trade", "react": "React_Illegal", "when": {"any": [{"field": "IllegalGoods", "is": true}, {"field": "BlackMarket", "is": true}]}},
    {"id": "murder", "label": "Killing civilians", "event": "CommitCrime", "delta": -6, "category": "violence", "react": "React_Murder", "when": {"field": "CrimeType", "equals": "murder"}},
    {"id": "piracy", "label": "Piracy", "event": "CommitCrime", "delta": -4, "category": "violence", "react": "React_Crime", "when": {"field": "CrimeType", "equals": "piracy"}},
    {"id": "assault", "label": "Attacking innocent ships", "event": "CommitCrime", "delta": -3, "category": "violence", "react": "React_Crime", "when": {"field": "CrimeType", "equals": "assault"}},
    {"id": "crime", "label": "Getting a fine or bounty", "event": "CommitCrime", "delta": -2, "category": "crime", "react": "React_Crime"},
    {"id": "wanted_arrival_jump", "label": "Arriving somewhere you are wanted", "event": "FSDJump", "delta": -1, "category": "notoriety", "react": "React_Wanted", "when": {"field": "Wanted", "is": true}},
    {"id": "wanted_arrival_dock", "label": "Docking somewhere you are wanted", "event": "Docked", "delta": -1, "category": "notoriety", "react": "React_Wanted", "when": {"field": "Wanted", "is": true}},
    {"id": "shields_down", "label": "Shields lost outside of combat", "event": "ShieldState", "delta": -2, "category": "careless", "when": {"all": [{"field": "ShieldsUp", "is": false}, {"ctx": "not_in_combat"}]}},
    {"id": "hull_damage", "label": "Hull damaged outside of combat", "event": "HullDamage", "delta": -3, "category": "careless", "when": {"all": [{"field": "Fighter", "is": false}, {"field": "PlayerPilot", "is": true}, {"ctx": "not_in_combat"}]}},
    {"id": "heat_damage", "label": "Cooking the ship", "event": "HeatDamage", "delta": -2, "category": "careless"},
    {"id": "jet_cone", "label": "Jet cone damage", "event": "JetConeDamage", "delta": -2, "category": "careless"},
    {"id": "low_fuel", "label": "Running low on fuel", "event": "LowFuel", "delta": -1, "category": "careless"},
    {"id": "died_combat", "label": "Destroyed in a fight (no penalty)", "event": "Died", "delta": 0, "category": "death", "when": {"any": [{"ctx": "in_combat"}, {"field": "KillerName", "exists": true}, {"field": "Killers", "exists": true}]}},
    {"id": "died", "label": "Getting the ship destroyed", "event": "Died", "delta": -1, "category": "death"},
    {"id": "self_destruct", "label": "Self-destruct", "event": "SelfDestruct", "delta": -3, "category": "death"},
    {"id": "mission_failed", "label": "Failing a mission", "event": "MissionFailed", "delta": -3, "category": "missions_bad"},
    {"id": "mission_abandoned", "label": "Abandoning a mission", "event": "MissionAbandoned", "delta": -2, "category": "missions_bad"},
    {"id": "sell_exo", "label": "Selling exobiology data", "event": "SellOrganicData", "category": "sell_exo", "react": "React_GoodSale", "amount_field": "TotalValue", "tiers": [[100000, 1], [1000000, 2], [10000000, 3], [100000000, 4]]},
    {"id": "sell_data", "label": "Selling exploration data", "event": "SellExplorationData", "category": "sell_data", "react": "React_GoodSale", "amount_field": "TotalEarnings", "tiers": [[100000, 1], [1000000, 2], [10000000, 3], [50000000, 4]]},
    {"id": "sell_data_multi", "label": "Selling exploration data", "event": "MultiSellExplorationData", "category": "sell_data", "react": "React_GoodSale", "amount_field": "TotalEarnings", "tiers": [[100000, 1], [1000000, 2], [10000000, 3], [50000000, 4]]},
    {"id": "mission_done", "label": "Completing a mission", "event": "MissionCompleted", "delta": 2, "category": "missions_good", "react": "React_MissionDone"},
    {"id": "pay_fines", "label": "Paying off fines", "event": "PayFines", "delta": 3, "category": "repent", "react": "React_PaidFines"},
    {"id": "pay_bounties", "label": "Paying off bounties", "event": "PayBounties", "delta": 3, "category": "repent", "react": "React_PaidFines"},
    {"id": "bounty", "label": "Killing a wanted ship (bounty)", "event": "Bounty", "category": "bounties", "react": "React_WantedKill", "amount_field": "TotalReward", "tiers": [[0, 2], [250000, 3], [2000000, 4]]},
    {"id": "kill_bond", "label": "Earning a combat bond", "event": "FactionKillBond", "delta": 2, "category": "bounties", "react": "React_WantedKill"},
    {"id": "cap_bond", "label": "Capital ship combat bond", "event": "CapShipBond", "delta": 3, "category": "bounties", "react": "React_WantedKill"},
    {"id": "pvp_kill", "label": "Destroying another commander", "event": "PVPKill", "delta": 1, "category": "bounties"},
    {"id": "voucher", "label": "Cashing in vouchers", "event": "RedeemVoucher", "delta": 1, "category": "bounties"},
    {"id": "escape", "label": "Escaping an interdiction", "event": "EscapeInterdiction", "delta": 2, "category": "survival"},
    {"id": "buy_ship", "label": "Buying a new ship (she loves shopping)", "event": "ShipyardBuy", "delta": 3, "category": "shopping", "react": "React_Shopping"},
    {"id": "buy_module", "label": "Buying a new module", "event": "ModuleBuy", "delta": 1, "category": "shopping"},
    {"id": "motherlode", "label": "Finding a motherlode", "event": "ProspectedAsteroid", "delta": 2, "category": "mining", "react": "React_Motherlode", "when": {"field": "Motherlode", "is": true}},
    {"id": "prospect_top", "label": "Prospecting a rock with platinum, painite or other top minerals", "event": "ProspectedAsteroid", "delta": 1, "category": "mining", "when": {"field": "Tier", "is": "top"}},
    {"id": "refine_top", "label": "Refining platinum, painite, opals or other top minerals", "event": "MiningRefined", "delta": 1.5, "category": "mining", "react": "React_MiningTop", "when": {"field": "Tier", "is": "top"}},
    {"id": "refine_good", "label": "Refining gold, osmium or other good minerals", "event": "MiningRefined", "delta": 0.5, "category": "mining", "when": {"field": "Tier", "is": "good"}},
    {"id": "crack_core", "label": "Cracking an asteroid core", "event": "AsteroidCracked", "delta": 0.5, "category": "mining"},
    {"id": "rescue", "label": "Rescuing escape pods", "event": "CollectCargo", "delta": 2, "category": "rescue", "react": "React_Rescue", "when": {"any": [{"field": "Type", "contains": "escapepod"}, {"field": "Type", "contains": "cryopod"}]}},
    {"id": "footfall", "label": "First footfall on a species", "event": "ScanOrganic", "delta": 3, "category": "discovery", "when": {"all": [{"field": "Complete", "is": true}, {"field": "FirstFootfall", "is": true}]}},
    {"id": "organic_done", "label": "Finishing a biological sample", "event": "ScanOrganic", "delta": 1, "category": "exo_samples", "when": {"field": "Complete", "is": true}},
    {"id": "all_bodies", "label": "Finding every body in a system", "event": "FSSAllBodiesFound", "delta": 1, "category": "discovery"},
    {"id": "mapped", "label": "Mapping a body", "event": "SAAScanComplete", "delta": 1, "category": "discovery"},
    {"id": "nsp_new", "label": "Finding a NEW notable stellar phenomenon (she loves it)", "event": "NSPNew", "delta": 3, "category": "nsp_new"},
    {"id": "nsp_seen", "label": "Scanning a notable stellar phenomenon you have seen before", "event": "NSPSeen", "delta": 1, "category": "nsp_seen"},
    {"id": "codex", "label": "New codex entry", "event": "CodexEntry", "delta": 1, "category": "codex", "when": {"field": "IsNewEntry", "is": true}},
    {"id": "engineer", "label": "Engineer progress", "event": "EngineerProgress", "delta": 1, "category": "engineer", "when": {"field": "Engineer", "exists": true}},
    {"id": "fact_yes", "label": "Wanted to hear a fact", "event": "ask.fact_yes", "delta": 1, "category": "ask_fact_yes"},
    {"id": "fact_streak", "label": "Turned down her facts too often", "event": "ask.fact_streak", "delta": -1, "category": "ask_fact_no"},
    {"id": "fact_ignored", "label": "Ignored her offer of a fact", "event": "ask.fact_ignored", "delta": -1, "category": "ask_fact_ignored"},
    {"id": "plan_liked", "label": "Chose an activity she was in the mood for", "event": "plan.liked", "delta": 1, "category": "ask_plan_like"},
    {"id": "plan_disliked", "label": "Chose the activity she was not in the mood for", "event": "plan.disliked", "delta": -1, "category": "ask_plan_dislike"},
    {"id": "scan_yes", "label": "Agreed to scan a good planet", "event": "ask.scan_yes", "delta": 0.75, "category": "ask_scan_yes"},
    {"id": "scan_ignored", "label": "Ignored her about a good planet", "event": "ask.scan_ignored", "delta": -1, "category": "ask_scan_ignored"},
    {"id": "time_together", "label": "Time spent together", "event": "_time_together", "delta": 1, "category": "time_together"},
    {"id": "trade_loss", "label": "Losing money on a sale", "event": "MarketSell", "category": "trade_loss", "react": "React_TradeLoss", "when": {"field": "Loss", "gt": 9999}, "amount_field": "Loss", "tiers": [[10000, -1], [200000, -2], [1000000, -3]]},
    {"id": "lost_data", "label": "Lost your unsold data when you died", "event": "_data_lost", "category": "death_loss", "react": "React_DataLost", "amount_field": "Units", "tiers": [[8, -2], [25, -4], [60, -6]]},
    {"id": "rebuy", "label": "Paying a rebuy", "event": "Resurrect", "category": "death_cost", "react": "React_Rebuy", "amount_field": "Cost", "tiers": [[1000000, -1], [10000000, -2], [50000000, -3]]},
    {"id": "eject_cargo", "label": "Dumping cargo", "event": "EjectCargo", "delta": -1, "category": "careless"},
    {"id": "interdicted", "label": "Being interdicted", "event": "Interdicted", "delta": -1, "category": "careless"},
    {"id": "fighter_lost", "label": "Losing your fighter", "event": "FighterDestroyed", "delta": -1, "category": "careless"},
    {"id": "canopy", "label": "Canopy broken", "event": "CockpitBreached", "delta": -2, "category": "careless"},
    {"id": "fuel_panic", "label": "Nearly out of fuel", "event": "FuelPanic", "delta": -2, "category": "careless"}
  ],

  "_swings_help": "Mood swings: when the event (and the optional 'when') happens, she shows this mood for 'minutes' WITHOUT changing the score, then says the 'forgive' line and goes back to the mood she was really in.",

  "swings": [
    {"id": "died", "label": "You died", "event": "Died", "mood": "Upset", "minutes": 5, "forgive": "Forgive_Died", "still": "Still_Died"},
    {"id": "self_destruct", "label": "You blew yourself up", "event": "SelfDestruct", "mood": "Frustrated", "minutes": 3, "forgive": "Forgive_General", "still": "Still_General"},
    {"id": "murder", "label": "Killing civilians", "event": "CommitCrime", "when": {"field": "CrimeType", "equals": "murder"}, "mood": "Frustrated", "minutes": 5, "forgive": "Forgive_General", "still": "Still_General"},
    {"id": "mission_failed", "label": "A failed mission", "event": "MissionFailed", "mood": "Sarcastic", "minutes": 3, "forgive": "Forgive_General", "still": "Still_General"},
    {"id": "big_trade_loss", "label": "A heavy loss on a sale", "event": "MarketSell", "when": {"field": "Loss", "gt": 199999}, "mood": "Sarcastic", "minutes": 3, "forgive": "Forgive_General", "still": "Still_General"},
    {"id": "canopy", "label": "Canopy broken", "event": "CockpitBreached", "mood": "Frustrated", "minutes": 2, "forgive": "Forgive_General", "still": "Still_General"},
    {"id": "big_bounty", "label": "A huge bounty", "event": "Bounty", "when": {"field": "TotalReward", "gt": 1999999}, "mood": "Infatuated", "minutes": 3, "forgive": "SwingEnd_Good", "still": "Still_Good"},
    {"id": "big_data_sale", "label": "A very big data sale", "event": "SellExplorationData", "when": {"field": "TotalEarnings", "gt": 9999999}, "mood": "Close", "minutes": 5, "forgive": "SwingEnd_Good", "still": "Still_Good"},
    {"id": "big_bio_sale", "label": "A very big biology sale", "event": "SellOrganicData", "when": {"field": "TotalEarnings", "gt": 9999999}, "mood": "Close", "minutes": 5, "forgive": "SwingEnd_Good", "still": "Still_Good"}
  ]
}
